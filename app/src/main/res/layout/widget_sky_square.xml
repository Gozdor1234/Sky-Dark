<?xml version="1.0" encoding="utf-8"?>
<!-- Square widget: place, current temperature and today's high/low over a sky that matches the
     current conditions, then the next four days. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/s_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/sky_clear_day" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/s_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sky Dark"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/s_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/temp_display"
                android:includeFontPadding="false"
                android:text="--°"
                android:textColor="#FFFFFFFF"
                android:textSize="48sp" />

            <ImageView
                android:id="@+id/s_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/s_hi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/s_lo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/s_cond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Open Sky Dark to load the forecast"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/s_cols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Spacer (plain View isn't allowed in home-screen widgets) -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp" />

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="High"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Low"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/d0_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/d0_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d0_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/d0_hi"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/d0_lo"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/d1_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/d1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d1_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/d1_hi"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/d1_lo"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/d2_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/d2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d2_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/d2_hi"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/d2_lo"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/d3_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/d3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d3_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/d3_hi"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/d3_lo"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
