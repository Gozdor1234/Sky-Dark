<?xml version="1.0" encoding="utf-8"?>
<!-- Square forecast widget whose background follows the current conditions. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="150dp"
    android:minResizeHeight="150dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_sky_square"
    android:previewLayout="@layout/widget_sky_square"
    android:description="@string/widget_square_description" />
